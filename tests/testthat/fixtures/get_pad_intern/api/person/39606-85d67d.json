            "kurzbiografie": {
                "gebtext": "Geb.: 02.11.1960, Graz",
                "beruflicheTaetigkeit": "Unternehmer",
                "beruflicherWerdegang": [
                    "Selbständig mit on.project Projektmanagement GmbH  seit 11/2001",
                    "Geschäftsführer der \"Technologie- und Standortagentur Salzburg GmbH\" (kurz \"Salzburg Agentur\") 1998-2002",
                    "Landesparteisekretär der FPÖ Salzburg 1996-1998",
                    "Geschäftsführer der Werbeagentur Scharler & Deller 1994-1996",
                    "Ressortsekretär beim Magistrat Salzburg und dem Amt der Salzburger Landesregierung (Bau- und Raumordnung) 1991-1993",
                    "Fachreferent für Wirtschaft, Außenpolitik und Justiz im Parlament 1988-1990",
                    "Mitarbeit im elterlichen Betrieb \"Rasthaus-Tankstelle Viertler\" in Kalwang (Steiermark) 1980-1988"
                ],
                "bildungsweg": [
                    "Invent GmbH, Institut für regionale Innovationen - Systematische Regionalentwicklung / Kooperationen und Netzwerke aus den Markt ausrichten / Innovationssysteme für regionale Wirtschaften 1999/2000",
                    "STRAIN ITC Regio, ÖAR Regionalberatung GmbH, vier Themenworkshops und Projektarbeit 1999/2000",
                    "Praxisorientierter Auslands- und Studienaufenthalt beim Österreichischen Handelsdelegierten in Washington, D.C. 8/2000-10/2000",
                    "Projekt- und Prozessmanagement-Lehrgang, next level Consulting 2000/2001",
                    "Promotion 16.3.1989",
                    "Studium der Rechtswissenschaften in Graz und Salzburg 1980-1988 (Sponsion 16.11.1988)",
                    "Präsenzdienst 1982-1983 (Bundesheer, Stab des Korpskommandos II)",
                    "Stiftgymnasium in Admont (Steiermark) 1971-1980",
                    "Volksschule in Kalwang (Steiermark) 1967-1971"
                ],
                "politischeFunktionen": [
                    "Bürgermeister der Stadtgemeinde Mittersill 2004-2024"
                ],
                "sonstiges": "<p>Tätigkeiten als Aufsichtsratsmitglied:<br>- Aufsichtsrat Land Salzburg Gesundheits-Holding GmbH seit 2025<br>- Mitglied des Vorstandes Privatstiftung Sparkasse Mittersill seit 2003<br>- Aufsichtsrat Salzburger Landeskliniken (SALK) 2023-2025<br>- Aufsichtsrat Gemeinnützige Salzburger Wohnbaugesellschaft m.b.H. (GSWB) 2023-2024<br>- Aufsichtsrats-Vorsitzender Gesundheit Innergebirg GmbH 2020-2024<br>- Aufsichtsrat Bergbahn AG Kitzbühel 2008-2024<br>- Aufsichtsrat Felbertauernstraße AG 2004-2024<br>- Zemka Ges.m.b.H. Müllverwertung 2004-2014<br>- Aufsichtsratsvorsitzender Sparkasse Mittersill 2005-2010<br>- Aufsichtsrat Sparkasse Mittersill Bank AG 2003-2005<br>- Salzburg AG für Energiewirtschaft (SAFE) 1995-2000<br>- Salzburger Hypothekenbank AG 1994-1998<\/p>",
                "bez": "Kurzbiografie",
